+/// ggcat LZ hook: observes every match right before it is copied.
+///
+/// `dst_pos` is the output position (relative to the sink base) the match is written to,
+/// `offset` the back-reference distance (which may reach into the external dictionary) and
+/// `match_length` the full match length.
+pub trait MatchHook {
+    /// Called once per match, before its bytes are copied.
+    fn on_match(&mut self, dst_pos: usize, offset: usize, match_length: usize);
+}
+
+/// The default hook: does nothing and compiles away.
+pub struct NoHook;
+
+impl MatchHook for NoHook {
+    #[inline(always)]
+    fn on_match(&mut self, _dst_pos: usize, _offset: usize, _match_length: usize) {}
+}
