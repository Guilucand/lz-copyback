+    pub buf: *mut u8,
+    pub size: usize,
+    /// Index in `buf` of the next byte to be decoded.
+    pub next: usize,
+    pub filtered: bool,
+    pub retire: Option<unsafe extern "C" fn(ctx: *mut libc::c_void, buf: *mut u8, size: usize)>,
+    pub retire_ctx: *mut libc::c_void,
+}
